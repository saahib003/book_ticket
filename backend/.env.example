APP_ENV=development
FLASK_DEBUG=true
SECRET_KEY=replace_with_long_random_value
JWT_SECRET_KEY=replace_with_another_long_random_value

DATABASE_URL=postgresql+psycopg://ticket_app:replace_with_local_password@127.0.0.1:5433/ticket_booking
DB_CONNECT_TIMEOUT=1
TEST_DATABASE_URL=postgresql+psycopg://ticket_app:replace_with_local_password@127.0.0.1:5433/ticket_booking_test

REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=0.25
REDIS_SOCKET_CONNECT_TIMEOUT=0.25
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
SOCKETIO_REDIS_URL=redis://localhost:6379/3
PAYMENT_PROVIDER=SIMULATED
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
HOLD_DURATION_SECONDS=300
MAX_SEATS_PER_HOLD=10
MAX_CONTENT_LENGTH=16384
CORS_ORIGIN=http://localhost:5173
LOGIN_RATE_LIMIT=5
HOLD_RATE_LIMIT=20
RATE_LIMIT_WINDOW_SECONDS=60
EVENT_CACHE_TTL_SECONDS=600
SHOW_CACHE_TTL_SECONDS=180
SEAT_MAP_CACHE_TTL_SECONDS=5
